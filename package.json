{
  "name": "@lazarus/root",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "bootstrap": "pnpm install --frozen-lockfile && pnpm build",
    "build": "pnpm build:js && cargo build --workspace --locked",
    "build:js": "nx run-many -t build",
    "gen:protocol": "buf generate",
    "typecheck": "nx run-many -t typecheck",
    "lint:js": "eslint .",
    "lint:rs": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "lint": "pnpm lint:js && pnpm lint:rs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "test:rs": "cargo test --workspace --locked",
    "dev:desktop": "pnpm --filter desktop dev",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:rs"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
